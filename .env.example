# Copy to `.env` and adjust per environment.
RESQAI_ENV=local
RESQAI_LOG_LEVEL=INFO

# API
RESQAI_API_HOST=0.0.0.0
RESQAI_API_PORT=8000

# Models / runtime
RESQAI_DEVICE=cpu
RESQAI_MODEL_CACHE_DIR=./artifacts/model_cache

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resqai_knowledge

# OpenWeatherMap
OPENWEATHER_API_KEY=
 
